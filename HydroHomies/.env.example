# Copy to .env and fill in. .env is gitignored.

# AI bottle estimate. The app calls OpenRouter directly with this key (no Cloud Function needed).
# It ends up inside the app bundle, so set a monthly spending limit on the key in OpenRouter.
EXPO_PUBLIC_OPENROUTER_API_KEY=
# Optional, defaults to google/gemini-2.5-flash
# EXPO_PUBLIC_OPENROUTER_MODEL=
# Optional: use the estimateBottle Cloud Function instead of a key (needs the Blaze plan)
# EXPO_PUBLIC_USE_ESTIMATE_FUNCTION=1

# Optional: run against local emulators (npm run emulators) instead of the real project
# EXPO_PUBLIC_USE_FIREBASE_EMULATORS=1
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2   # Android emulator; use your PC's LAN IP for a phone

# Optional: point the app at a different Firebase project (defaults to hydrohype-9fa73)
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

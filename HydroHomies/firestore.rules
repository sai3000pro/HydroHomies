rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isMl(v) { return v is int && v >= 0 && v <= 3000; }

    // Private profile: email and body stats. Only the owner can see it.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.get('username', '') is string
        && request.resource.data.get('username', '').size() <= 24;
      allow delete: if false;

      // Friends: users/{uid}/friends/{friendId}. Adding is mutual, so A writes both
      // A/friends/B and B/friends/A. Both docs carry B's friend code, which proves A knows it.
      match /friends/{friendId} {
        function codeOwner(code) {
          return get(/databases/$(database)/documents/friendCodes/$(code)).data.userId;
        }
        allow read: if isOwner(uid);
        allow create: if signedIn()
          && friendId != uid
          && request.resource.data.friendId == friendId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 24
          && request.resource.data.code is string
          && (
            // My own list: I know their code
            (request.auth.uid == uid && codeOwner(request.resource.data.code) == friendId)
            // Their list: they're adding me, and the code is theirs
            || (request.auth.uid == friendId && codeOwner(request.resource.data.code) == uid)
          );
        // Either side can end the friendship
        allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == friendId);
        allow update: if false;
      }
    }

    // friendCodes/{CODE}: public lookup from a short code to a user. Get only, so codes can't be listed.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 24
        && code.matches('^[A-Z0-9]{6}$');
      allow update, delete: if false;
    }

    // Pets are public to signed-in users (leaderboard, friend view).
    match /pets/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.species in ['elephant', 'alien', 'sphele']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.experience is int
        // New pets start at 0; pets migrated from the hackathon build keep their small XP
        && request.resource.data.experience >= 0
        && request.resource.data.experience <= 1000;
      // XP can only grow, and by at most what one maximum-size drink earns (3000 ml -> 300 XP)
      allow update: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.species == resource.data.species
        && request.resource.data.experience is int
        && request.resource.data.experience >= resource.data.experience
        && request.resource.data.experience <= resource.data.experience + 300
        && request.resource.data.health >= 0
        && request.resource.data.health <= 100;
      allow delete: if false;
    }

    // Individual drinks: private to the owner.
    match /hydrationEntries/{entryId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && isMl(request.resource.data.amount)
        && request.resource.data.amount > 0
        && request.resource.data.dateKey is string;
      allow update, delete: if false;
    }

    // One doc per user per day, id "{uid}_{YYYY-MM-DD}". Public: it drives the leaderboard.
    match /dailySummaries/{summaryId} {
      // On create `resource` is null, so the previous total is 0
      function prevTotal() { return resource == null ? 0 : resource.data.totalMl; }
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && summaryId == request.auth.uid + '_' + request.resource.data.dateKey
        && request.resource.data.totalMl is int
        // Each write adds one drink of at most 3000 ml
        && request.resource.data.totalMl >= prevTotal()
        && request.resource.data.totalMl <= prevTotal() + 3000;
      allow delete: if false;
    }

    // aiUsage/{uid}_{day}: written only by the estimateBottle function (Admin SDK).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

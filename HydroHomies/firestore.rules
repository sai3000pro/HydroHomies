rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isMl(v) { return v is int && v >= 0 && v <= 3000; }
    function entryPath(id) { return /databases/$(database)/documents/hydrationEntries/$(id); }

    // "YYYY-MM-DD" for a timestamp (UTC). Local dates are within a day of UTC.
    function pad(n) { return n < 10 ? '0' + string(n) : string(n); }
    function dk(t) { return string(t.year()) + '-' + pad(t.month()) + '-' + pad(t.day()); }
    function isRecentDateKey(k) {
      return k == dk(request.time)
        || k == dk(request.time - duration.value(1, 'd'))
        || k == dk(request.time + duration.value(1, 'd'));
    }

    // `id` is a drink created in this same write (it didn't exist before, it does after)
    function isNewEntry(id, uid) {
      return id is string && id != ''
        && !exists(entryPath(id))
        && existsAfter(entryPath(id))
        && getAfter(entryPath(id)).data.userId == uid;
    }
    // `id` is a drink deleted in this same write
    function isRemovedEntry(id, uid) {
      return id is string && id != ''
        && exists(entryPath(id))
        && !existsAfter(entryPath(id))
        && get(entryPath(id)).data.userId == uid;
    }

    // Private profile: email and body stats. Only the owner can see it.
    match /users/{uid} {
      // The hackathon-era users/{uid}.pet can only be removed (by the migration), never
      // added or edited; otherwise it could be planted to "migrate" a high-XP pet
      function legacyPetUntouched() {
        return !('pet' in request.resource.data)
          || (resource != null && 'pet' in resource.data
            && request.resource.data.pet == resource.data.pet);
      }
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && legacyPetUntouched()
        && request.resource.data.get('username', '') is string
        && request.resource.data.get('username', '').size() <= 24
        && request.resource.data.get('stats', {}).get('dailyWaterGoal', 2500) is number
        && request.resource.data.get('stats', {}).get('dailyWaterGoal', 2500) >= 500
        && request.resource.data.get('stats', {}).get('dailyWaterGoal', 2500) <= 10000;
      // Account deletion
      allow delete: if isOwner(uid);

      // Friends: users/{uid}/friends/{friendId}. Adding is mutual, so A writes both
      // A/friends/B and B/friends/A. Both docs carry B's friend code, which proves A knows it.
      match /friends/{friendId} {
        function codeOwner(code) {
          return get(/databases/$(database)/documents/friendCodes/$(code)).data.userId;
        }
        allow read: if isOwner(uid);
        allow create: if signedIn()
          && friendId != uid
          && request.resource.data.friendId == friendId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 24
          && request.resource.data.code is string
          && (
            // My own list: I know their code
            (request.auth.uid == uid && codeOwner(request.resource.data.code) == friendId)
            // Their list: they're adding me, and the code is theirs
            || (request.auth.uid == friendId && codeOwner(request.resource.data.code) == uid)
          );
        // The friend can update how their own name appears on your list (after renaming)
        allow update: if signedIn()
          && request.auth.uid == friendId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 24;
        // Either side can end the friendship
        allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == friendId);
      }
    }

    // friendCodes/{CODE}: public lookup from a short code to a user. Get only, so codes can't be listed.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 24
        && code.matches('^[A-Z0-9]{6}$');
      // The owner can keep the name current, or retire the code (new code / account deletion)
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 24;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Pets are public to signed-in users (leaderboard, friend view).
    match /pets/{uid} {
      function isPetName(n) { return n is string && n.size() > 0 && n.size() <= 20; }
      function isHealth(h) { return h is number && h >= 0 && h <= 100; }
      function xpDelta() { return request.resource.data.experience - resource.data.experience; }
      function linked() { return request.resource.data.get('lastEntryId', ''); }
      function userPath() { return /databases/$(database)/documents/users/$(uid); }
      // Account deletion sets users/{uid}.deleting first; then the pet may go
      function accountDeleting() {
        return exists(userPath()) && get(userPath()).data.get('deleting', false) == true;
      }
      // The one-time move of a hackathon pet out of users/{uid}.pet, in the same write
      function isLegacyMigration() {
        return exists(userPath()) && 'pet' in get(userPath()).data
          && existsAfter(userPath()) && !('pet' in getAfter(userPath()).data);
      }
      function lastFedUnchanged() {
        return request.resource.data.get('lastFed', null) == resource.data.get('lastFed', null);
      }
      // A drink restores at most (ml / daily goal) * 100 health, on top of the last stored value
      function healthWithin(amount) {
        let goal = get(userPath()).data.get('stats', {}).get('dailyWaterGoal', 2500);
        return request.resource.data.health <= resource.data.get('health', 100) + amount * 100 / goal + 1;
      }

      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.species in ['elephant', 'alien', 'sphele']
        && isPetName(request.resource.data.name)
        && request.resource.data.experience is int
        // New pets start at 0; only a migrated hackathon pet keeps its (capped) XP
        && (request.resource.data.experience == 0
          || (isLegacyMigration()
            && request.resource.data.experience > 0
            && request.resource.data.experience <= 1000))
        && isHealth(request.resource.data.get('health', 100));
      // XP only moves together with a drink in the same write: +ml/10 when one is logged,
      // back down (at most that much) when one is deleted. Feeding stamps lastFed with the
      // server time, so health decay can't be paused. Renaming changes nothing else.
      allow update: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.species == resource.data.species
        && isPetName(request.resource.data.name)
        && request.resource.data.experience is int
        && request.resource.data.experience >= 0
        && isHealth(request.resource.data.health)
        && (
          (isNewEntry(linked(), uid)
            && xpDelta() == math.floor(getAfter(entryPath(linked())).data.amount / 10)
            && healthWithin(getAfter(entryPath(linked())).data.amount)
            && request.resource.data.lastFed == request.time)
          || (isRemovedEntry(linked(), uid)
            && xpDelta() <= 0
            && -xpDelta() <= math.floor(get(entryPath(linked())).data.amount / 10)
            // Undoing a drink never adds health
            && request.resource.data.health <= resource.data.get('health', 100)
            && lastFedUnchanged())
          || (xpDelta() == 0 && request.resource.data.health == resource.data.health
            && lastFedUnchanged())
        );
      allow delete: if isOwner(uid) && accountDeleting();
    }

    // Individual drinks: private to the owner.
    match /hydrationEntries/{entryId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && isMl(request.resource.data.amount)
        && request.resource.data.amount > 0
        && request.resource.data.dateKey is string
        && isRecentDateKey(request.resource.data.dateKey)
        && request.resource.data.timestamp == request.time;
      // Deleting a drink must take its ml off that day's total and its XP off the pet in the
      // same write, so log-then-delete can't be used to farm. (Docs deleted in the same write,
      // as in account deletion, are skipped.) The app only offers undo for 24 hours.
      function summaryOf() {
        return /databases/$(database)/documents/dailySummaries/$(request.auth.uid + '_' + resource.data.get('dateKey', 'none'));
      }
      function petOf() { return /databases/$(database)/documents/pets/$(request.auth.uid); }
      function lowered(before, by) { return before >= by ? before - by : 0; }
      // During account deletion (users/{uid}.deleting) drinks can go without the totals,
      // which are deleted too. One cached read, so big batches stay under the access limit.
      function accountDeleting() {
        let u = /databases/$(database)/documents/users/$(request.auth.uid);
        return exists(u) && get(u).data.get('deleting', false) == true;
      }
      function summaryLowered() {
        return !existsAfter(summaryOf())
          || getAfter(summaryOf()).data.totalMl == lowered(get(summaryOf()).data.totalMl, resource.data.amount);
      }
      function petLowered() {
        return !existsAfter(petOf())
          || getAfter(petOf()).data.experience
            == lowered(get(petOf()).data.experience, math.floor(resource.data.amount / 10));
      }
      allow delete: if signedIn() && resource.data.userId == request.auth.uid
        && (accountDeleting() || (summaryLowered() && petLowered()));
      allow update: if false;
    }

    // One doc per user per day, id "{uid}_{YYYY-MM-DD}". Public: it drives the leaderboard.
    match /dailySummaries/{summaryId} {
      // On create `resource` is null, so the previous total is 0
      function prevTotal() { return resource == null ? 0 : resource.data.totalMl; }
      function delta() { return request.resource.data.totalMl - prevTotal(); }
      function linked() { return request.resource.data.get('lastEntryId', ''); }
      function prevCount() { return resource == null ? 0 : resource.data.entryCount; }
      function petPath() { return /databases/$(database)/documents/pets/$(request.auth.uid); }
      // Without a pet the summary shows 0 XP; with one, exactly the pet's XP and health after this write
      function petMatches() {
        return existsAfter(petPath())
          ? request.resource.data.petExperience == getAfter(petPath()).data.experience
            && request.resource.data.petHealth == getAfter(petPath()).data.health
          : request.resource.data.petExperience == 0;
      }
      function sameDay(e) {
        return e.dateKey == request.resource.data.dateKey && e.amount == (delta() < 0 ? -delta() : delta());
      }
      // Removing a drink lowers the total by its amount, or to 0 if the total was already smaller
      function sameDayRemoved(e) {
        return e.dateKey == request.resource.data.dateKey
          && (e.amount == -delta() || (request.resource.data.totalMl == 0 && -delta() < e.amount));
      }
      function validShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['userId', 'dateKey', 'displayName', 'totalMl', 'goalMl',
            'entryCount', 'petName', 'petSpecies', 'petExperience', 'petHealth', 'updatedAt',
            'lastEntryId'])
          && d.totalMl is int && d.totalMl >= 0
          && d.displayName is string && d.displayName.size() <= 24
          && d.goalMl is number && d.goalMl >= 500 && d.goalMl <= 10000
          && d.entryCount is int && d.entryCount >= 0
          && (d.petName == null || (d.petName is string && d.petName.size() <= 20))
          && (d.petSpecies == null || d.petSpecies in ['elephant', 'alien', 'sphele'])
          && d.petExperience is int && d.petExperience >= 0
          && d.petHealth is number && d.petHealth >= 0 && d.petHealth <= 100;
      }
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && summaryId == request.auth.uid + '_' + request.resource.data.dateKey
        && validShape()
        && (
          // The total only changes by exactly the drink logged or deleted in this write,
          // and the pet numbers shown on the leaderboard match the pet after the write
          (delta() > 0 && isNewEntry(linked(), request.auth.uid)
            && sameDay(getAfter(entryPath(linked())).data)
            && request.resource.data.entryCount == prevCount() + 1
            && petMatches())
          || (delta() < 0 && isRemovedEntry(linked(), request.auth.uid)
            && sameDayRemoved(get(entryPath(linked())).data)
            && request.resource.data.entryCount == (prevCount() > 0 ? prevCount() - 1 : 0)
            && petMatches())
          // Display info (e.g. a new username or pet name) can change on its own
          || (delta() == 0 && resource != null
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'petName', 'updatedAt']))
        );
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // drinkPhotos/{entryId}: before/after thumbnails of one drink (JPEG data URIs).
    // Visible to the owner and their friends, so friends can check the drink was real.
    match /drinkPhotos/{entryId} {
      function isFriendOf(owner) {
        return exists(/databases/$(database)/documents/users/$(owner)/friends/$(request.auth.uid));
      }
      function isThumb(v) { return v is string && v.size() < 400000 && v.matches('^data:image/jpeg;base64,.*'); }
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isFriendOf(resource.data.userId));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && isThumb(request.resource.data.before)
        && isThumb(request.resource.data.after)
        // The photos belong to a drink this user logged, and describe it truthfully
        && get(entryPath(entryId)).data.userId == request.auth.uid
        && request.resource.data.amount == get(entryPath(entryId)).data.amount
        && request.resource.data.dateKey == get(entryPath(entryId)).data.dateKey;
      // You can take your photos down, but not edit them
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;

      // drinkPhotos/{entryId}/reactions/{uid}: one emoji reaction per viewer
      match /reactions/{reactorId} {
        function photoOwner() {
          return get(/databases/$(database)/documents/drinkPhotos/$(entryId)).data.userId;
        }
        function canSee() {
          return photoOwner() == request.auth.uid || isFriendOf(photoOwner());
        }
        allow read: if signedIn() && canSee();
        allow create, update: if signedIn()
          && reactorId == request.auth.uid
          && canSee()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.emoji in ['💧', '🔥', '🤡', '🧢']
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 24;
        // The reactor can take it back; the photo owner can clear it when deleting the photos.
        // A photo that's already gone can't be looked up, so the reactor check comes first.
        allow delete: if signedIn()
          && (reactorId == request.auth.uid || photoOwner() == request.auth.uid);
      }
    }

    // Collection-group lookup of your own reactions, used when deleting your account
    match /{path=**}/reactions/{reactorId} {
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Everything else, e.g. aiUsage written by the optional estimateBottle function (Admin SDK)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
